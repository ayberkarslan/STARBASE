{
  "name": "starbase",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @starbase/web",
    "dev:api": "npm run dev -w @starbase/api",
    "build": "npm run build -w @starbase/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "npm run db:migrate -w @starbase/api"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
