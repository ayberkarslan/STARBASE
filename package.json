{
  "name": "starbase",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @starbase/web",
    "dev:todo": "npm run build -w @stardrop/ui && npm run build -w @starbase/sdk && npm run dev -w @starbase/todo",
    "dev:api": "npm run dev -w @starbase/api",
    "build": "npm run pack:sdk && npm run build -w @stardrop/ui && npm run build -w @starbase/web",
    "build:todo": "npm run build -w @stardrop/ui && npm run build -w @starbase/sdk && npm run build -w @starbase/todo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "npm run db:migrate -w @starbase/api",
    "emulators": "node scripts/emulators.mjs",
    "example:web": "vite examples/vite --host 127.0.0.1 --port 5180",
    "openapi": "node scripts/openapi.mjs",
    "test:ui": "playwright test",
    "test:smoke": "node scripts/smoke.mjs",
    "build:sdk": "npm run build -w @starbase/sdk",
    "pack:sdk": "node scripts/pack-sdk.mjs",
    "emulators:save": "firebase emulators:export .firebase-data --only auth --project demo-starbase --force",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "firebase-tools": "^15.34.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
